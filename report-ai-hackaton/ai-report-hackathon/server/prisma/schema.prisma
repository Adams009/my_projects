generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  REPORTER
  TRIAGE_OFFICER
  TEAM_MEMBER
  SUPERVISOR
  ORGANIZATION_ADMIN
}

enum OrganizationType {
  GOVERNMENT
  COMPANY
  SCHOOL
  HOSPITAL
  NGO
  COMMUNITY
  OTHER
}

enum Category {
  ROAD_INFRASTRUCTURE
  DRAINAGE_FLOODING
  WASTE_SANITATION
  WATER_PLUMBING
  ELECTRICAL_LIGHTING
  BUILDING_MAINTENANCE
  ICT_EQUIPMENT
  OTHER_FACILITY_ISSUE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  ASSIGNED
  ACKNOWLEDGED
  IN_PROGRESS
  AWAITING_REVIEW
  NEEDS_INFORMATION
  REASSIGNMENT_REQUESTED
  RESOLVED
  VERIFIED
  CLOSED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

enum AssignmentStatus {
  PENDING
  ACKNOWLEDGED
  IN_PROGRESS
  COMPLETED
  DECLINED
  CANCELLED
}

enum AssignmentReviewStatus {
  NOT_REVIEWED
  APPROVED
  REJECTED
}

model Organization {
  id        String            @id @default(uuid())
  name      String
  slug      String            @unique
  type      OrganizationType?
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  users       User[]
  memberships OrganizationMembership[]
  invitations OrganizationInvitation[]
  teams       Team[]
  locations   Location[]
  reports     Report[]
}

model RateLimitCounter {
  storeName String   @map("store_name")
  key       String
  totalHits Int      @map("total_hits")
  resetAt   DateTime @map("reset_at") @db.Timestamptz(3)

  @@id([storeName, key])
  @@index([resetAt])
  @@map("rate_limit_counters")
}

model User {
  id             String   @id @default(uuid())
  organizationId String?
  firstName      String?
  lastName       String?
  email          String   @unique
  passwordHash   String?
  role           Role     @default(REPORTER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization?            @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  memberships         OrganizationMembership[]
  sentInvitations     OrganizationInvitation[] @relation("InvitationInviter")
  reports             Report[]                 @relation("ReportReporter")
  historyEvents       ReportHistory[]          @relation("HistoryActor")
  assignmentsCreated  ReportAssignment[]       @relation("AssignmentCreator")
  assignmentsReviewed ReportAssignment[]       @relation("AssignmentReviewer")
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@index([organizationId])
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OrganizationMembership {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           Role     @default(REPORTER)
  teamId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([teamId])
}

model OrganizationInvitation {
  id             String           @id @default(uuid())
  organizationId String
  invitedById    String
  email          String
  tokenHash      String           @unique
  role           Role             @default(REPORTER)
  teamId         String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  declinedAt     DateTime?
  status         InvitationStatus @default(PENDING)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
}

model Team {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reports           Report[]
  memberships       OrganizationMembership[]
  invitations       OrganizationInvitation[]
  reportAssignments ReportAssignment[]

  @@index([organizationId])
}

model Location {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reports      Report[]

  @@index([organizationId])
}

model Report {
  id             String       @id @default(uuid())
  organizationId String
  reporterId     String
  locationId     String?
  assignedTeamId String?
  title          String?
  description    String
  category       Category
  priority       Priority     @default(MEDIUM)
  status         ReportStatus @default(SUBMITTED)
  aiSummary      String?
  aiCategory     Category?
  aiConfidence   Float?
  aiRationale    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reporter     User               @relation("ReportReporter", fields: [reporterId], references: [id])
  location     Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignedTeam Team?              @relation(fields: [assignedTeamId], references: [id], onDelete: SetNull)
  history      ReportHistory[]
  assignments  ReportAssignment[]
  images       ReportImage[]

  @@index([organizationId])
  @@index([reporterId])
  @@index([status])
  @@index([assignedTeamId])
}

model ReportImage {
  id        String   @id @default(uuid())
  reportId  String
  url       String
  publicId  String
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model ReportHistory {
  id             String        @id @default(uuid())
  reportId       String
  actorId        String?
  previousStatus ReportStatus?
  newStatus      ReportStatus
  action         String
  notes          String?
  createdAt      DateTime      @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actor  User?  @relation("HistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@index([actorId])
}

model ReportAssignment {
  id             String                 @id @default(uuid())
  reportId       String
  teamId         String
  assignedById   String
  reviewedById   String?
  status         AssignmentStatus       @default(PENDING)
  reviewStatus   AssignmentReviewStatus @default(NOT_REVIEWED)
  assignedAt     DateTime               @default(now())
  acknowledgedAt DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  reviewedAt     DateTime?
  completionNote String?
  reviewNote     String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  report     Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  team       Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignedBy User   @relation("AssignmentCreator", fields: [assignedById], references: [id])
  reviewedBy User?  @relation("AssignmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@index([teamId])
  @@index([assignedById])
  @@index([reviewedById])
  @@index([status])
  @@index([reviewStatus])
}
