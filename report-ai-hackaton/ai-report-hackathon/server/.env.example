NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/civicfix

# Generate separate random values; never use placeholders or commit the values.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated exact browser origins; no trailing slash.
CORS_ORIGINS=http://localhost:5173
CLIENT_URL=http://localhost:5173

# For a frontend and API on different sites, use SameSite=None and Secure=true.
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
TRUST_PROXY_HOPS=0

# SMTP settings are mandatory in production for password resets and invitations.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Cloudinary image storage for optional report attachments.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required only when running the local demo seed; do not use in production.
SEED_DEMO_PASSWORD=
